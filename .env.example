# Copy to .env (never commit .env). Real values go only in .env or the container environment.
APP_ENV=development
APP_NAME=Revenue recovery agent

# The PostgreSQL database the API uses. Note the +psycopg2 driver part.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DB_NAME

# Ollama (the local LLM server). Inside Docker use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# Only for the optional PostgreSQL integration tests (tests/test_database.py): a SEPARATE database whose
# name ends in _test. Those tests roll back everything they do. Never point this at the real database.
TEST_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DB_NAME_test

# Used by docker-compose.yml (inside a container, "localhost" is the container itself):
# CONTAINER_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@host.docker.internal:5432/DB_NAME
# CONTAINER_OLLAMA_URL=http://host.docker.internal:11434

# LLM provider: "ollama" (local) or "gemini" (cloud; also set GEMINI_API_KEY in the environment)
# LLM_PROVIDER=ollama
# GEMINI_MODEL=gemini-2.5-flash-lite

# Live demo console (public portfolio demo)
# DEMO_MODE=true                          # enables the /gateway/* write endpoints (synthetic data only)
# DEMO_ACCESS_TOKEN=                      # REQUIRED with DEMO_MODE: a shared access code, set only on the server
# DEMO_ALLOW_OPEN_ACCESS=false            # local development only: DEMO_MODE without a code
# DEMO_MAX_LLM_RUNS_PER_HOUR=30
# DEMO_MAX_EVENTS_PER_HOUR=60
# DEMO_BATCH_ENABLED=false                # batch runs are off unless true
# DEMO_BATCH_MAX=3
# CORS_ORIGINS=http://localhost:5173      # comma-separated exact origins, no trailing slash; set to the deployed frontend
# DEMO_CURRENCY=INR
